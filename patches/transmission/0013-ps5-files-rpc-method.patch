+// PS5 guard v9: the read-only method ps5_files for the file picker of the web interface. {} -> the connected disks;
+// { path } -> the subfolders and the *.torrent files of a folder (the shared picker core builds the JSON, here it is parsed).
+[[nodiscard]] std::pair<JsonRpc::Error::Code, std::string> ps5Files(tr_session* /*session*/, tr_variant::Map const& args_in, tr_variant::Map& args_out)
+{
+    auto const path = args_in.value_if<std::string_view>(tr_quark_new("path"sv)).value_or(""sv);
+    std::vector<char> buf(512U * 1024U);
+    int truncated = 0;
+    int error = 0;
+    if (std::empty(path))
+    {
+        if (ps5tm_disks_json(buf.data(), buf.size()) != 0)
+        {
+            return { JsonRpc::Error::INTERNAL_ERROR, "the disk list does not fit" };
+        }
+    }
+    else
+    {
+        std::string const p{ path };
+        if (ps5tm_files_json(p.c_str(), 1, ".torrent", buf.data(), buf.size(), &truncated, &error) != 0)
+        {
+            args_out.try_emplace(tr_quark_new("ok"sv), false);
+            args_out.try_emplace(tr_quark_new("error"sv), std::string_view{ error == 1 ? "outside" : error == 2 ? "nodir" : "badpath" });
+            return { JsonRpc::Error::SUCCESS, {} };
+        }
+    }
+    (void)truncated;
+
+    auto serde = tr_variant_serde::json();
+    auto parsed = serde.parse(std::string_view{ buf.data() });
+    auto* const map = parsed ? parsed->get_if<tr_variant::Map>() : nullptr;
+    if (map == nullptr)
+    {
+        return { JsonRpc::Error::INTERNAL_ERROR, "cannot parse the picker answer" };
+    }
+    args_out = std::move(*map);
+    return { JsonRpc::Error::SUCCESS, {} };
+}
+
