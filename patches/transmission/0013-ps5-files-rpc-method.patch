+// PS5 guard v9: the read-only file picker of the web interface (implemented in the daemon wrapper: src/daemon/fs_picker.cc, src/common/fs_list.cc)
+extern "C" int ps5tm_files_json(char const* path, int want_files, char const* ext, char* out, size_t out_size, int* truncated, int* error);
+extern "C" int ps5tm_disks_json(char* out, size_t out_size);
